{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Mobile",
  "version": "0.3.35",
  "identifier": "com.jsmile.codex-mobile",
  "build": {
    "beforeDevCommand": {
      "script": "node scripts/native.mjs dev-assets",
      "cwd": "../../.."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "node scripts/native.mjs build-assets",
      "cwd": "../../.."
    },
    "frontendDist": "../../../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Mobile",
        "width": 1000,
        "height": 840,
        "minWidth": 720,
        "minHeight": 580,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "resources": {
      "../../../dist/mobile/": "mobile/",
      "binaries/": "bin/",
      "release.json": "release.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}

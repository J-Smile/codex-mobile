{$CODEX_MOBILE_DOMAIN} {
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}
	@app not path /preview-sandbox.html
	# Noise 的加密依赖会实例化 WebAssembly。
	header @app Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	header /preview-sandbox.html Content-Security-Policy "frame-ancestors 'self'; sandbox allow-scripts"

	handle /relay/* {
		reverse_proxy relay:8080
	}

	@desktopAssets path /api /api/* /relay-media/*
	handle @desktopAssets {
		respond 404
	}

	handle {
		root * /srv/codex-mobile
		encode gzip
		header / Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		header /version.json Cache-Control "no-store"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
